# Example environment configuration for Benris.
# Copy this file to `.env` and fill in your own values:
#   cp .env.example .env
#
# `.env` is git-ignored — never commit real keys.

# --- Language models --------------------------------------------------------

# Primary model (fast). Benris tries Groq first when this is set.
GROQ_API_KEY=

# Fallback model (Claude). Used if Groq fails, or directly if Groq is unset.
ANTHROPIC_API_KEY=

# Optional: route Anthropic requests through a proxy / gateway.
ANTHROPIC_BASE_URL=

# Optional: override the Claude model id (defaults to claude-sonnet-4-5).
CLAUDE_MODEL=claude-sonnet-4-5

# --- Audio devices (optional) ----------------------------------------------
# Zero-based indexes. Leave unset to use the system defaults.
# The active microphone and voice are shown in the UI.

# BENRIS_MICROPHONE_INDEX=1
# BENRIS_VOICE_INDEX=139
